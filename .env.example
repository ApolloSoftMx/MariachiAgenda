# Copia este archivo a .env y ajusta los valores antes de exponer el servidor.
PORT=3000

# URL pública (la usa la cookie segura y los enlaces). En local: http://localhost:3000
APP_URL=http://localhost:3000

# El bot de Telegram y el acceso con Google también se pueden configurar
# desde la pantalla: Configuración → Configuración del sistema.
# Lo que guardes ahí tiene prioridad sobre estas variables.
BOT_TOKEN=
BOT_USERNAME=

# Acceso con Google (opcional).
# Crea credenciales en https://console.cloud.google.com/apis/credentials
# Tipo: "ID de cliente de OAuth 2.0" -> Aplicación web.
# URI de redirección autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Si APP_URL no es la URL pública exacta, define aquí la redirección completa.
# GOOGLE_REDIRECT_URI=https://agenda.tudominio.com/api/auth/google/callback

# Registro abierto: cualquiera puede solicitar acceso desde el login.
# Las solicitudes quedan pendientes hasta que el super administrador las apruebe
# desde la web o desde Telegram (botones Aprobar / Rechazar).
ALLOW_REGISTRATION=true
# Si es false, Google solo permite entrar a cuentas ya aprobadas.
ALLOW_GOOGLE_SIGNUP=true

# Color de los eventos en los que vas como invitado (opcional).
# También se puede cambiar en Configuración → Color de eventos como invitado.
GUEST_EVENT_COLOR=#e11d48

# Ruta al archivo SQLite (opcional). Por defecto: ./data/agenda.db
DB_PATH=

# Carpeta de respaldos (opcional). Por defecto: ./data/backups
BACKUP_DIR=

# Primer usuario (solo se usa si la base está vacía).
# Si no defines SEED_ADMIN_PASSWORD se genera una aleatoria y se imprime en consola.
SEED_ADMIN_EMAIL=owner@agenda.local
SEED_ADMIN_NAME=Super administrador
SEED_ADMIN_PASSWORD=

# Cobro mensual para otros usuarios. Por defecto apagado (preparado para el futuro).
ENABLE_SUBSCRIPTIONS=false
